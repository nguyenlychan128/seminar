# Node Environment
NODE_ENV=development

# Server
PORT=3001

# MongoDB
# Connection string for MongoDB. Used by src/config/database.js
# Format: mongodb://[username[:password]@]host[:port]/database
# Local: mongodb://localhost:27017/fitgainer-auth
# Docker: mongodb://mongo:27017/fitgainer-auth
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/fitgainer-auth
MONGO_URI=mongodb://localhost:27017/fitgainer-auth

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# OpenTelemetry (Optional)
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RabbitMQ (Async Events)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=fitgainer.events

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting (Optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW=86400
RATE_LIMIT_REGISTER_MAX_ACCOUNTS=3
