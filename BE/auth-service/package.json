{
  "name": "fitgainer-auth-service",
  "version": "1.0.0",
  "description": "FitGainer Authentication Service - JWT-based auth for fitness app",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --detectOpenHandles --runInBand",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "echo 'lint not configured'"
  },
  "keywords": [
    "authentication",
    "jwt",
    "express",
    "mongodb",
    "fitgainer"
  ],
  "author": "FitGainer Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^9.0.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
