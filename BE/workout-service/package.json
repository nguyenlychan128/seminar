{
  "name": "fitgainer-workout-service",
  "version": "1.0.0",
  "description": "FitGainer Workout Service - Exercise library, workout plan templates, personalized plans",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --detectOpenHandles --runInBand",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js"
  },
  "keywords": ["workout", "exercise", "fitness", "express", "mongodb", "fitgainer"],
  "author": "FitGainer Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^9.0.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
