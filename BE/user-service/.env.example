# Node Environment
NODE_ENV=development

# Server
PORT=3002

# MongoDB
# Connection string for MongoDB. Used by src/config/database.js
# Format: mongodb://[username[:password]@]host[:port]/database
# Local: mongodb://localhost:27017/fitgainer-user
# Docker: mongodb://mongo:27017/fitgainer-user
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/fitgainer-user
MONGO_URI=mongodb://localhost:27017/fitgainer-user

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ (Async Events)
RABBITMQ_URL=amqp://localhost:5672

# Logging
LOG_LEVEL=debug

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
